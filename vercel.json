{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ],
  "crons": [
    {
      "path": "/api/cron-daily",
      "schedule": "30 2 * * 1-6"
    },
    {
      "path": "/api/cron-daily-evening",
      "schedule": "15 10 * * 1-6"
    },
    {
      "path": "/api/cron-escalate",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/auto-logout",
      "schedule": "30 16 * * *"
    }
  ]
}